s":[{"label":"字符串","localized_name":"字符串","name":"string","type":"STRING","widget":{"name":"string"}}],"outputs":[{"label":"字符串输出","localized_name":"字符串输出","name":"STRING","type":"STRING","links":[543,1120]}],"title":"共享提示词（一采/二采共用 · 只改这一处）","properties":{"aux_id":"giriss/comfy-image-saver","ver":"65e6903eff274a50f8b5cd768f0f96baf37baea1","Node name for S&R":"String Literal","cnr_id":"comfy-image-saver","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.5.1"},"widget_ue_connectable":{"string":true}},"widgets_values":["采用微距镜头从高角度俯拍少女蜷缩在蕾丝床单上的纤细身躯，浅景深将背景玩偶与纱帐柔和虚化，画面充满被偷窥的私密甜美感与禁忌感。午后阳光透过蕾丝窗帘在少女肌肤投下细碎菱形光斑，整体粉白色调，高光柔和泛奶白，阴影泛淡粉，氛围甜腻暧昧。20岁洛丽塔少女，圆润幼态脸，粉白肌肤，娇小骨架，甜美感中透着一丝被玩弄的纯真。浅亚麻色长卷发用樱桃发带束成双马尾披散枕间，发丝凌乱沾在脸颊。妆容是甜妹妆——大面积桃粉腮红扫过鼻梁，亮片眼影在泪腺处闪烁，亮泽唇釉涂出刻意的不规则边界。眉头微蹙，迷离眼眸失焦望向虚空，唇瓣微启，神情介于恍惚与沉溺之间。身着一件白色蕾丝洛丽塔洋装，泡泡袖，胸前缎带蝴蝶结系带，薄透面料被胡乱撩起堆在腰间，白色棉质内裤被拉下褪至大腿根处，蕾丝裙摆精致花边紧贴裸露肌肤。她侧卧蜷缩在床上，一侧膝盖蜷向胸口，臀部轻微起伏晃动，呼吸随每一次细微动作而微微急促。洛丽塔少女卧室，蕾丝帐纱从天花板垂落，矮柜上排列棉花糖香水与陶瓷玩偶，床头泰迪熊用丝带蒙眼。构图采用中心对称，少女蜷缩躯体占据画面中央，四周蕾丝与蝴蝶结形成包围感，视线向中心汇聚。"]},{"id":314,"type":"SaveLatent","pos":[530.4692953433429,802.0535538379612],"size":[274.5756144379799,91.6061140593929],"flags":{"collapsed":true},"order":49,"mode":0,"inputs":[{"localized_name":"Latent","name":"samples","type":"LATENT","link":578},{"localized_name":"文件名前缀","name":"filename_prefix","type":"STRING","widget":{"name":"filename_prefix"},"link":579}],"outputs":[{"localized_name":"samples","name":"samples","type":"LATENT","links":[]}],"title":"一采latent落盘（文件名含种子）","properties":{"cnr_id":"comfy-core","ver":"0.31.0","Node name for S&R":"SaveLatent","ue_properties":{"widget_ue_connectable":{"filename_prefix":true},"version":"7.5.2","input_ue_unconnectable":{}}},"widgets_values":["latents/Krea2一采-seed"]},{"id":465,"type":"String Literal","pos":[529.9121052156687,746.9296919567447],"size":[250.58359375,88],"flags":{"collapsed":true},"order":21,"mode":0,"inputs":[{"label":"字符串","localized_name":"字符串","name":"string","type":"STRING","widget":{"name":"st