operties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.5.1"},"widget_ue_connectable":{},"aux_id":"pythongosssss/ComfyUI-Custom-Scripts"},"widgets_values":["采用低角度广角从地板平面微仰拍，前景为水渍与跳蛋特写，上方为蹲姿少女身影，浅景深突出焦点。侧窗暖光斜射，水渍表面形成镜面反光，跳蛋水珠晶莹透亮，整体暖棕木质色调，阴影处纹理深邃，氛围潮湿暧昧。20岁洛丽塔少女，圆润幼态脸，粉白肌肤，娇小纤细，羞涩中透着紧张。浅亚麻长卷发披散肩侧，碎发垂落脸侧。妆容是甜妹妆——淡粉腮红晕染，水润唇釉，睫毛微翘。目光低垂闪躲，脸颊绯红，唇瓣紧抿，神情羞耻不安。She wears a white lace lolita babydoll dress with puffed sleeves and ribbon ties, the dress bunched up at her waist, her white cotton panties pulled down and hanging limply around both ankles as she balances on tiptoes. She is squatting on tiptoes with her knees spread wide apart, her thighs trembling slightly, her fingers gripping her inner thighs for balance. 宾馆房间，木质地板纹理清晰，角落散落脱下的玛丽珍鞋，远处未整理的白色床单边缘虚化。构图采用前景与引导线，水渍与粉色跳蛋占据画面下方中央，少女蹲姿居中上方，木纹引导线汇聚至主体。"]},{"id":300,"type":"Fast Bypasser (rgthree)","pos":[-285.54839590437496,219.1751157500364],"size":[325.9688639538924,122],"flags":{},"order":33,"mode":0,"inputs":[{"dir":3,"label":"","name":"一采LoRA1加载器（仅模型）","type":"*","link":571},{"dir":3,"name":"二采LoRA2加载器（仅模型）","type":"*","link":1121},{"dir":3,"name":"","type":"*","link":null}],"outputs":[{"dir":4,"label":"可选连接","name":"OPT_CONNECTION","type":"*","links":[]}],"title":"忽略Lora","properties":{"toggleRestriction":"default","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.7"}},"color":"#432","bgcolor":"#653"},{"id":272,"type":"LoraLoaderModelOnly","pos":[-282.47221295704907,472.95791166740247],"size":[312.5048374129375,149.89524365900036],"flags":{},"order":27,"mode":4,"inputs":[{"label":"model","localized_name":"模型","name":"model","type":"MODEL","link":560},{"label":"lora_name","localized_name":"LoRA名称","name":"lora_name","type":"COMBO","widget":{"name":"lora_name"},"link":null},{"label":"strength_model","localized_name":"模型强度","name":"strength_model","type":"FLOAT","widget":{"name":"strength_model"},"link":null}],"outputs":[{"label":"MODEL","localized_name":"模型","nam